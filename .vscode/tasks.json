{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Android Emulator",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd StatusPRO_Emulator",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Status PRO (Full Build + Launch)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\run_emulator.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}